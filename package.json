{
  "name": "pokerbeer-bench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite web",
    "build": "vite build web",
    "arena:vercel:dev": "node --env-file=.env.local node_modules/vercel/dist/index.js dev --local --listen 3100",
    "arena:vercel:build": "node --env-file=.env.local node_modules/vercel/dist/index.js build",
    "db:migrate": "bun scripts/migrate.ts",
    "harbor:build": "docker build -f harbor/Dockerfile -t pokerbeer-bench:local .",
    "harbor:trial": "bun harbor/runner/main.ts",
    "harbor:publish": "node --env-file=.env.local harbor/viewer/publish.ts",
    "harbor:snapshot": "node --env-file=.env.local harbor/viewer/snapshot.ts",
    "typecheck": "tsc --noEmit && uv run --locked ty check . --error-on-warning",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch && uv run --locked ruff check .",
    "test": "vitest run",
    "test:harbor": "PYTHONPATH=harbor uv run --locked python -m unittest discover -s tests -p 'test_*.py'",
    "format": "prettier --write . && uv run --locked ruff format .",
    "format:check": "prettier --check . && uv run --locked ruff format --check .",
    "check:loc": "node scripts/check-loc.ts",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run test:harbor && bun run check:loc",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.41",
    "@base-ui/react": "1.7.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@neondatabase/serverless": "1.1.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@vercel/blob": "2.8.0",
    "@vercel/sandbox": "3.1.0",
    "openai": "6.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "pg": "8.16.3",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vercel": "59.16.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
